---
interface Props {
	title: string;
	description?: string;
	noindex?: boolean;
}
const {
	title,
	description = "Ateliers vente avec Alex — coaching commercial individuel pour solopreneurs.",
	noindex = true,
} = Astro.props;
---

<!doctype html>
<html lang="fr">
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		{noindex && <meta name="robots" content="noindex, follow" />}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Montserrat:wght@400;700&display=swap"
			rel="stylesheet"
		/>
	</head>
	<body>
		<nav class="top-nav">
			<div class="nav-inner">
				<a href="/"
					><img
						src="/logo-alex.png"
						alt="La Méthode Alex — retour à l'accueil"
						class="brand-logo"
					/></a
				>
			</div>
		</nav>
		<main class="container">
			<slot />
		</main>
		<footer class="site-footer">
			<div class="footer-links">
				<a href="/">Accueil</a> |
				<a href="/mentions-legales">Mentions légales</a> |
				<a href="/cgv">CGV</a> |
				<a href="/politique-de-confidentialite">Confidentialité</a>
			</div>
			© {new Date().getFullYear()} ATELIERS VENTE AVEC ALEX — TOUS DROITS
			RÉSERVÉS
		</footer>
	</body>
</html>

<style is:global>
	html,
	body {
		margin: 0;
		background: #000;
		color: #eee;
		font-family: "Montserrat", sans-serif;
		line-height: 1.75;
	}
	h1,
	h2,
	h3 {
		font-family: "Oswald", sans-serif;
		text-transform: uppercase;
		color: #fff;
	}
	h1 {
		font-size: 2.4rem;
		margin-top: 3rem;
	}
	h2 {
		font-size: 1.4rem;
		margin-top: 2.5rem;
		color: #ff5500;
	}
	a {
		color: #ff8c55;
	}
	.container {
		max-width: 800px;
		margin: 0 auto;
		padding: 0 1.5rem 4rem;
	}
	.top-nav {
		border-bottom: 2px solid #c44914;
		background: #000;
	}
	.nav-inner {
		max-width: 800px;
		margin: 0 auto;
		padding: 0.8rem 1.5rem;
	}
	.brand-logo {
		display: block;
		max-height: 55px;
		width: auto;
	}
	.site-footer {
		text-align: center;
		padding: 3rem 1.5rem;
		color: #666;
		border-top: 1px solid #111;
		font-size: 0.9rem;
		line-height: 2;
	}
	.footer-links a {
		color: #999;
		text-decoration: none;
		margin: 0 0.5rem;
	}
	.footer-links a:hover {
		color: #ff5500;
	}
	.placeholder {
		background: #2a1408;
		border-left: 4px solid #ff5500;
		padding: 0.15rem 0.5rem;
	}
</style>
