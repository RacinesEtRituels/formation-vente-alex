				<a href="/mentions-legales">Mentions légales</a> |
				<a href="/cgv">CGV</a> |
				<a href="/politique-de-confidentialite">Confidentialité</a>
			</div>
			© {new Date().getFullYear()} ATELIERS VENTE AVEC {
				expertName.toUpperCase()
			} — TOUS DROITS RÉSERVÉS
		</footer>

		<a
			href="/audit"
			class="floating-audit-cta"
			id="floating-audit-cta"
			aria-hidden="true"
			tabindex="-1"
		>
			Faites le point en 3 min →
		</a>

		<script is:inline define:vars={{ STRIPE_LINKS, LEAD_ENDPOINT }}>
			// Pré-sélection du module depuis les boutons "Réserver"
			const select = document.getElementById("product-choice");
			document.querySelectorAll(".js-choose-module").forEach((btn) => {
				btn.addEventListener("click", () => {
					const slug = btn.dataset.slug;
					if (slug && STRIPE_LINKS[slug]) select.value = slug;
				});
			});

			// Soumission : enregistrement du prospect puis redirection Stripe
			const form = document.getElementById("payment-form");
			const submitBtn = document.getElementById("submit-btn");
			const errorBox = document.getElementById("form-error");

			const showError = (msg) => {
				errorBox.textContent = msg;
				errorBox.style.display = "block";
			};

			form.addEventListener("submit", async (e) => {
				e.preventDefault();
				errorBox.style.display = "none";

				const firstName = document.getElementById("fname").value.trim();
				const email = document
					.getElementById("email")
					.value.trim()
					.toLowerCase();
				const slug = select.value;
				const formatPref = document.getElementById("format-pref").value;
				const consent = document.getElementById("consent").checked;

				if (!firstName || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
					showError(
						"Merci d'indiquer votre prénom et une adresse email valide.",
					);
					return;
				}
				if (!consent) {
					showError(
						"Merci d'accepter la politique de confidentialité et les CGV pour continuer.",
					);
					return;
				}
				const stripeUrl = STRIPE_LINKS[slug];
				if (!stripeUrl || !stripeUrl.startsWith("https://buy.stripe.com/")) {
					showError(
						"Petit souci de lien de paiement : merci de recharger la page ou de nous contacter.",
					);
					return;
				}

				submitBtn.disabled = true;
				submitBtn.textContent = "REDIRECTION EN COURS…";

				// Enregistrement du prospect (ne bloque jamais le paiement)
				let ref = "";
				try {
					const res = await fetch(LEAD_ENDPOINT, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							first_name: firstName,
							email: email,
							product_slug: slug,
							format_pref: formatPref,
						}),
					});
					if (res.ok) {
						const data = await res.json();
						if (data && data.ref) ref = data.ref;
					}
				} catch (_) {
					/* on redirige quand même vers le paiement */
				}

				const url = new URL(stripeUrl);
				url.searchParams.set("prefilled_email", email);
				if (ref) url.searchParams.set("client_reference_id", `${slug}__${ref}`);
				window.location.href = url.toString();
			});
		</script>

		<script is:inline>
			// CTA flottant vers /audit : apparaît après le premier écran,
			// se retire quand le formulaire d'inscription ou le footer est visible.
			(function () {
				const cta = document.getElementById("floating-audit-cta");
				if (!cta) return;

				const hideZones = Array.from(
					document.querySelectorAll("#register, .site-footer"),
				);
				const intersecting = new Set();
				let pastFold = false;

				const apply = () => {
					const show = pastFold && intersecting.size === 0;
					cta.classList.toggle("is-visible", show);
					cta.setAttribute("aria-hidden", show ? "false" : "true");
					if (show) cta.removeAttribute("tabindex");
					else cta.setAttribute("tabindex", "-1");
				};

				const onScroll = () => {
					pastFold = window.scrollY > window.innerHeight;
					apply();
				};
				window.addEventListener("scroll", onScroll, { passive: true });
				window.addEventListener("resize", onScroll, { passive: true });
				onScroll();

				if ("IntersectionObserver" in window && hideZones.length) {
					const io = new IntersectionObserver((entries) => {
						for (const e of entries) {
							if (e.isIntersecting) intersecting.add(e.target);
							else intersecting.delete(e.target);
						}
						apply();
					});
					hideZones.forEach((el) => io.observe(el));
				}
			})();
		</script>
	</body>
</html>
