const expertName = "Alex";

const modules = [
	{
		slug: "module-1",
		num: "01",
		title: "ARCHITECTURE & RADAR CLIENT",
		tool: "Le Radar Client Haute-Précision",
		desc: "Arrêtez de gaspiller votre énergie sur des prospects qui ne signeront jamais. Dans cette session en tête-à-tête, nous décortiquons la psychologie de VOTRE acheteur idéal et nous construisons votre matrice d'acquisition sur-mesure : vous saurez exactement où chasser, comment prioriser vos efforts et comment devenir l'évidence aux yeux de votre marché.",
		price: "150€",
	},
	{
		slug: "module-2",
		num: "02",
		title: "LA TRAME DE CLOSING INFRANCHISSABLE",
		tool: "Votre Script de Vente A à Z",
		desc: "La vente n'est pas une improvisation, c'est une science. Je construis avec vous la structure exacte pour mener n'importe quel entretien, de la première poignée de main à la signature finale. Vous repartez avec VOTRE script : les questions qui font mouche, l'autorité immédiate, et le chemin vers le « oui » sans jamais passer pour un vendeur agressif.",
		price: "150€",
	},
	{
		slug: "module-3",
		num: "03",
		title: "GUÉRILLA : PROSPECTION & PHONING",
		tool: "Le Script Brise-Glace Éprouvé",
		desc: "Le téléphone est votre meilleur allié, pas votre ennemi. Je vous transmets les techniques de terrain héritées des foires et du porte-à-porte : briser le barrage du secrétariat, capter l'attention en moins de 10 secondes et transformer la peur du rejet en adrénaline de conquête. On s'entraîne ensemble, en conditions réelles.",
		price: "150€",
	},
	{
		slug: "module-4",
		num: "04",
		title: "MAÎTRISE TOTALE DES OBJECTIONS",
		tool: "Le Guide de Riposte Commerciale",
		desc: "« C'est trop cher », « Je dois réfléchir », « On verra plus tard ». Ces phrases ne sont plus des obstacles, mais des invitations à conclure. Nous passons en revue les objections que VOUS entendez le plus, et je vous donne les répliques exactes et l'attitude mentale pour désamorcer les doutes et verrouiller vos prix sans concession.",
		price: "150€",
	},
];
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="fr_FR" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Montserrat:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--tony-black: #000000;
				--tony-orange: #ff5500;
				--tony-gray: #111111;
				--white: #ffffff;
				--nav-height: 84px;
			}

			body {
				background: var(--tony-black);
				color: var(--white);
				font-family: "Montserrat", sans-serif;
				margin: 0;
				scroll-behavior: smooth;
			}

			h1,
			h2,
			h3,
			.oswald {
				font-family: "Oswald", sans-serif;
				text-transform: uppercase;
			}

			.container {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.urgency-bar {
				background: #c44914;
				color: #000;
				font-weight: 900;
				text-align: center;
				padding: 0.85rem 1rem;
				letter-spacing: 0.4px;
				text-transform: uppercase;
			}

			.top-nav {
				position: sticky;
				top: 0;
				z-index: 1000;
				height: var(--nav-height);
				display: flex;
				align-items: center;
				background: rgba(0, 0, 0, 0.78);
				backdrop-filter: blur(8px);
				border-bottom: 2px solid #c44914;
			}

			.nav-inner {
				max-width: 1100px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.brand-logo {
				display: block;
				max-height: 60px;
				width: auto;
			}

			.nav-cta {
				color: var(--white);
				text-decoration: none;
				font-weight: 700;
				font-size: 0.9rem;
				letter-spacing: 1px;
				border: 2px solid var(--tony-orange);
				padding: 0.6rem 1.2rem;
				border-radius: 4px;
				transition: 0.3s;
			}
			.nav-cta:hover {
				background: var(--tony-orange);
			}

			/* HERO */
			.hero {
				min-height: 90vh;
				padding-top: calc(var(--nav-height) + 1.5rem);
				padding-bottom: 3rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;
				background:
					linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
					url("https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1600&q=60");
				background-size: cover;
				background-position: center;
				border-bottom: 10px solid var(--tony-orange);
			}
			.hero h1 {
				font-size: 5.2rem;
				margin: 0;
				line-height: 0.95;
				letter-spacing: -2px;
				font-weight: 900;
			}
			.hero h1 span {
				color: var(--tony-orange);
			}
			.hero .subtitle {
				font-size: 1.5rem;
				color: #ccc;
				max-width: 850px;
				margin: 2rem auto;
				font-weight: 400;
			}
			.hero-badges {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				justify-content: center;
				margin-bottom: 2.2rem;
			}
			.hero-badge {
				border: 1px solid rgba(255, 255, 255, 0.35);
				background: rgba(0, 0, 0, 0.55);
				padding: 0.55rem 1.1rem;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
			}
			.hero-badge strong {
				color: var(--tony-orange);
			}

			/* ÉTAPES */
			.steps {
				background: #0a0a0a;
				padding: 4.5rem 0;
				border-bottom: 1px solid #222;
			}
			.steps h2 {
				text-align: center;
				font-size: 2.6rem;
				margin-bottom: 3rem;
			}
			.steps-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 30px;
			}
			.step {
				border: 1px solid #333;
				background: #000;
				padding: 2.2rem;
				text-align: center;
			}
			.step-num {
				font-family: "Oswald", sans-serif;
				font-size: 2.6rem;
				color: var(--tony-orange);
				font-weight: 700;
			}
			.step h3 {
				font-size: 1.25rem;
				margin: 0.8rem 0;
			}
			.step p {
				color: #bbb;
				line-height: 1.7;
				margin: 0;
			}

			/* PAINS */
			.pains {
				background: var(--tony-gray);
				padding: 6rem 0;
				border-bottom: 1px solid #222;
			}
			.pains h2 {
				font-size: 3rem;
				text-align: center;
				margin-bottom: 1rem;
			}
			.pains .pains-sub {
				text-align: center;
				color: #bbb;
				font-size: 1.15rem;
				max-width: 750px;
				margin: 0 auto 4rem;
			}
			.pain-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 30px;
			}
			.pain-item {
				background: #000;
				border: 1px solid #333;
				padding: 2.5rem;
				border-radius: 4px;
				text-align: center;
				font-weight: 700;
				transition: 0.3s;
			}
			.pain-item:hover {
				border-color: var(--tony-orange);
				transform: translateY(-5px);
			}
			.pain-emoji {
				font-size: 3rem;
				margin-bottom: 1rem;
			}

			/* MODULES */
			.modules {
				padding: 7rem 0;
			}
			.module-row {
				background: #111;
				margin-bottom: 3rem;
				border: 1px solid #222;
				transition: 0.3s;
			}
			.module-row:hover {
				border-color: #444;
			}
			.module-content {
				padding: 4rem;
			}
			.module-content h3 {
				font-size: 2.5rem;
				margin: 1rem 0;
				color: #fff;
			}
			.tool-label {
				color: var(--tony-orange);
				font-weight: 900;
				letter-spacing: 2px;
				font-size: 0.9rem;
			}
			.module-desc {
				font-size: 1.2rem;
				line-height: 1.8;
				color: #bbb;
				margin-bottom: 2.5rem;
			}
			.module-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1px solid #333;
				padding-top: 2rem;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.module-price {
				font-size: 2.5rem;
				font-weight: 900;
			}
			.module-price small {
				display: block;
				font-size: 0.85rem;
				color: #888;
				font-weight: 400;
			}

			/* PACK */
			.pack-premium {
				background: linear-gradient(45deg, #000, #1a100a);
				border: 4px solid var(--tony-orange);
				padding: 5rem 3rem;
				text-align: center;
				margin-top: 6rem;
			}

			/* FORMULAIRE & BOUTONS */
			.btn-tony {
				background: var(--tony-orange);
				color: white;
				padding: 1.5rem 3.5rem;
				text-decoration: none;
				font-weight: 900;
				display: inline-block;
				font-size: 1.3rem;
				border-radius: 4px;
				transition: 0.3s;
				border: none;
				cursor: pointer;
				font-family: "Oswald", sans-serif;
				text-transform: uppercase;
			}
			.btn-tony:hover {
				transform: scale(1.05);
				filter: brightness(1.2);
			}
			.btn-tony:disabled {
				opacity: 0.6;
				cursor: wait;
				transform: none;
			}

			.form-section {
				background: #fff;
				color: #000;
				padding: 5rem 0;
			}
			.form-card {
				max-width: 600px;
				margin: 0 auto;
			}
			.form-card h2 {
				font-size: 3rem;
				margin-bottom: 1rem;
				text-align: center;
			}
			.form-card label {
				display: block;
				font-weight: 700;
				margin-bottom: 0.4rem;
				font-size: 0.95rem;
			}
			input[type="text"],
			input[type="email"],
			select {
				width: 100%;
				padding: 1.2rem;
				margin-bottom: 1.5rem;
				border: 2px solid #eee;
				font-size: 1rem;
				font-family: "Montserrat", sans-serif;
				box-sizing: border-box;
				background: #fff;
			}
			.consent-row {
				display: flex;
				gap: 0.7rem;
				align-items: flex-start;
				margin-bottom: 1.5rem;
				font-size: 0.88rem;
				line-height: 1.55;
				color: #333;
			}
			.consent-row input {
				margin-top: 0.2rem;
				width: 1.1rem;
				height: 1.1rem;
			}
			.form-error {
				display: none;
				background: #ffe8e0;
				border-left: 4px solid #c0392b;
				color: #7b241c;
				padding: 0.9rem 1rem;
				margin-bottom: 1.4rem;
				font-size: 0.95rem;
			}

			.location-note {
				font-size: 1.02rem;
				line-height: 1.75;
				color: #1f1f1f;
				background: #fff4ed;
				border-left: 4px solid var(--tony-orange);
				padding: 1rem 1.1rem;
				margin: 0.3rem 0 1.4rem;
			}

			.site-footer {
				text-align: center;
				padding: 4rem 1.5rem;
				color: #666;
				border-top: 1px solid #111;
				font-size: 0.9rem;
				line-height: 2;
			}
			.footer-logo {
				display: block;
				width: 150px;
				max-width: 100%;
				height: auto;
				margin: 0 auto 1.2rem;
			}
			.footer-links a {
				color: #999;
				text-decoration: none;
				margin: 0 0.7rem;
			}
			.footer-links a:hover {
				color: var(--tony-orange);
			}

			.social-proof {
				font-size: 0.95rem;
				line-height: 1.5;
				font-weight: 700;
				max-width: 640px;
				margin: 1.3rem auto 0;
			}

			@media (max-width: 768px) {
				:root {
					--nav-height: 76px;
				}
				.urgency-bar {
					font-size: 0.78rem;
					line-height: 1.5;
				}
				.hero h1 {
					font-size: 3.2rem;
				}
				.module-content {
					padding: 2rem;
				}
				.pack-premium {
					padding: 3rem 1.5rem;
				}
			}
		</style>
	</head>
	<body>
		<div class="urgency-bar">
			COACHING 100% INDIVIDUEL — EN VISIO OU EN PRÉSENTIEL À MORNANT (69)
		</div>

		<nav class="top-nav">
			<div class="nav-inner">
				<img
					src="/logo-alex.png"
					alt="La Méthode Alex — coaching vente"
					class="brand-logo"
				/>
				<a href="#register" class="nav-cta">RÉSERVER MA SESSION</a>
			</div>
		</nav>

		<section class="hero">
			<div class="container">
				<h1>
					VOUS ÊTES SEUL À VENDRE.<br />
					<span>PAS SEUL POUR APPRENDRE.</span>
				</h1>
				<p class="subtitle">
					Coaching commercial en tête-à-tête pour solopreneurs et
					indépendants. Ma mission : vous transmettre des outils
					concrets qui deviennent des leviers immédiats de croissance.
					Vous repartez de chaque session avec un plan d'action prêt à
					l'emploi, pour vendre dès le lendemain et transformer chaque
					opportunité en client fidèle.
				</p>
				<div class="hero-badges">
					<div class="hero-badge">
						<strong>1:1</strong> — Session individuelle sur-mesure
					</div>
					<div class="hero-badge">
						<strong>Visio ou présentiel</strong> à Mornant (69)
					</div>
					<div class="hero-badge">
						<strong>À votre rythme</strong> — 1 module ou les 4
					</div>
				</div>
				<a href="#register" class="btn-tony">RÉSERVER MA SESSION</a>
			</div>
		</section>

		<section class="steps">
			<div class="container">
				<h2>COMMENT ÇA MARCHE ?</h2>
				<div class="steps-grid">
					<div class="step">
						<div class="step-num">1</div>
						<h3>Choisissez votre module</h3>
						<p>
							Un module ciblé sur votre point faible, ou le pack
							complet pour une transformation totale.
						</p>
					</div>
					<div class="step">
						<div class="step-num">2</div>
						<h3>Réglez en ligne</h3>
						<p>
							Paiement sécurisé par Stripe. Vous recevez
							immédiatement votre confirmation par email.
						</p>
					</div>
					<div class="step">
						<div class="step-num">3</div>
						<h3>Je vous contacte sous 24h</h3>
						<p>
							Nous fixons ensemble la date de votre session, en
							visio ou en présentiel à Mornant, selon vos
							disponibilités.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="pains">
			<div class="container">
				<h2>POURQUOI VOUS NE SIGNEZ PAS ASSEZ ?</h2>
				<p class="pains-sub">
					Quand on est solopreneur, personne ne vend à votre place.
					Chaque blocage commercial se paie directement sur votre
					chiffre d'affaires.
				</p>
				<div class="pain-grid">
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">🤐</div>
						L'OBJECTION VOUS FAIT RECULER
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">📞</div>
						LE PHONING VOUS PARALYSE
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">📉</div>
						VOTRE CLOSING EST ALÉATOIRE
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">🧱</div>
						VOTRE PRIX EST UN OBSTACLE
					</div>
				</div>
			</div>
		</section>

		<section class="modules">
			<div class="container">
				<h2
					style="text-align:center; font-size: 4rem; margin-bottom: 1.5rem;"
				>
					PROGRAMME D'EXCELLENCE
				</h2>
				<p
					style="text-align:center; color:#bbb; font-size:1.15rem; max-width:750px; margin:0 auto 5rem;"
				>
					Chaque module est une session individuelle en tête-à-tête,
					adaptée à VOTRE activité, VOS clients et VOS blocages.
					Travaillez un seul module ou enchaînez les quatre.
				</p>

				{
					modules.map((m) => (
						<div class="module-row" id={m.slug}>
							<div class="module-content">
								<span class="tool-label">
									INCLUS : {m.tool}
								</span>
								<h3>
									{m.num}. {m.title}
								</h3>
								<p class="module-desc">{m.desc}</p>
								<div class="module-footer">
									<span class="module-price">
										{m.price}
										<small>Session individuelle 1:1</small>
									</span>
									<a
										href="#register"
										class="btn-tony js-choose-module"
										data-slug={m.slug}
										style="padding: 1rem 2rem; font-size: 1rem;"
									>
										RÉSERVER CE MODULE
									</a>
								</div>
							</div>
						</div>
					))
				}

				<div class="pack-premium">
					<span
						class="oswald"
						style="color: var(--tony-orange); font-size: 1.5rem;"
						>OFFRE D'IMMERSION TOTALE</span
					>
					<h2 style="font-size: 4rem; color: #fff; margin: 1rem 0;">
						PACK COMPLET "L'EXPERT DU TERRAIN"
					</h2>
					<p
						style="font-size: 1.4rem; color: #ccc; margin-bottom: 2rem;"
					>
						Les 4 modules en accompagnement individuel, pour une
						transformation radicale de vos revenus.
					</p>
					<p
						style="font-size: 1.15rem; margin: 0 0 2.5rem; font-weight: 700; color: var(--tony-orange);"
					>
						4 sessions en tête-à-tête, en visio ou en présentiel à
						Mornant — planifiées à votre rythme.
					</p>
					<div
						style="font-size: 5rem; font-weight: 900; color: var(--tony-orange); margin-bottom: 2rem;"
					>
						490€
						<span
							style="font-size: 1.5rem; text-decoration: line-through; color: #555; font-weight: normal;"
							>600€</span
						>
					</div>
					<a
						href="#register"
						class="btn-tony js-choose-module"
						data-slug="pack-complet"
						style="padding: 2rem 4rem; font-size: 1.5rem;"
						>JE VEUX LE PACK COMPLET</a
					>
				</div>
			</div>
		</section>

		<section id="register" class="form-section">
			<div class="container">
				<div class="form-card">
					<h2>PASSEZ À L'ACTION</h2>
					<p style="text-align: center; margin-bottom: 3rem;">
						Remplissez vos informations pour être redirigé vers le
						paiement sécurisé Stripe.
					</p>

					<form id="payment-form" novalidate>
						<label for="fname">Prénom</label>
						<input
							type="text"
							id="fname"
							name="first_name"
							placeholder="Votre prénom"
							autocomplete="given-name"
							required
						/>

						<label for="email">Adresse email</label>
						<input
							type="email"
							id="email"
							name="email"
							placeholder="vous@exemple.fr"
							autocomplete="email"
							required
						/>

						<label for="product-choice">Votre choix</label>
						<select id="product-choice" name="product_slug">
							<option value="pack-complet"
								>PACK COMPLET — 4 sessions individuelles — 490€</option
							>
							<option value="module-1"
								>Module 01 : Architecture & Radar Client — 150€</option
							>
							<option value="module-2"
								>Module 02 : La Trame de Closing Infranchissable
								— 150€</option
							>
							<option value="module-3"
								>Module 03 : Guérilla — Prospection & Phoning —
								150€</option
							>
							<option value="module-4"
								>Module 04 : Maîtrise Totale des Objections —
								150€</option
							>
						</select>

						<label for="format-pref">Format souhaité</label>
						<select id="format-pref" name="format_pref">
							<option value="visio">En visio</option>
							<option value="presentiel"
								>En présentiel à Mornant (69440)</option
							>
						</select>

						<p class="location-note">
							Après votre règlement, je vous contacte
							personnellement sous 24h pour fixer ensemble la date
							de votre session, selon vos disponibilités.
						</p>

						<div class="consent-row">
							<input
								type="checkbox"
								id="consent"
								name="consent"
								required
							/>
							<label for="consent" style="font-weight: 400;">
								J'accepte que mes informations soient utilisées
								pour gérer mon inscription et être recontacté
								dans le cadre de ma session, conformément à la
								<a href="/politique-de-confidentialite"
									>politique de confidentialité</a
								>. J'accepte les
								<a href="/cgv">conditions générales de vente</a
								>.
							</label>
						</div>

						<p class="form-error" id="form-error"></p>

						<button
							type="submit"
							id="submit-btn"
							class="btn-tony"
							style="width: 100%;"
							>VALIDER ET PAYER SUR STRIPE</button
						>
						<p
							class="social-proof"
							style="text-align: center; color: #2a2a2a; margin-top: 1rem;"
						>
							Paiement sécurisé par Stripe. Accompagnement 100%
							individuel — votre session, vos objectifs, votre
							marché.
						</p>
					</form>
				</div>
			</div>
		</section>

		<footer class="site-footer">
			<img
				src="/logo-alex.png"
				alt="La Méthode Alex"
				class="footer-logo"
			/>
			<div class="footer-links">
				<a href="/mentions-legales">Mentions légales</a> |
				<a href="/cgv">CGV</a> |
				<a href="/politique-de-confidentialite">Confidentialité</a>
			</div>
			© {new Date().getFullYear()} ATELIERS VENTE AVEC {
				expertName.toUpperCase()
			} — TOUS DROITS RÉSERVÉS
		</footer>

		<script is:inline define:vars={{ STRIPE_LINKS, LEAD_ENDPOINT }}>
			// Pré-sélection du module depuis les boutons "Réserver"
			const select = document.getElementById("product-choice");
			document.querySelectorAll(".js-choose-module").forEach((btn) => {
				btn.addEventListener("click", () => {
					const slug = btn.dataset.slug;
					if (slug && STRIPE_LINKS[slug]) select.value = slug;
				});
			});

			// Soumission : enregistrement du prospect puis redirection Stripe
			const form = document.getElementById("payment-form");
			const submitBtn = document.getElementById("submit-btn");
			const errorBox = document.getElementById("form-error");

			const showError = (msg) => {
				errorBox.textContent = msg;
				errorBox.style.display = "block";
			};

			form.addEventListener("submit", async (e) => {
				e.preventDefault();
				errorBox.style.display = "none";

				const firstName = document.getElementById("fname").value.trim();
				const email = document
					.getElementById("email")
					.value.trim()
					.toLowerCase();
				const slug = select.value;
				const formatPref = document.getElementById("format-pref").value;
				const consent = document.getElementById("consent").checked;

				if (!firstName || !/^[^@\s]+@[^@\s]+\.[^@\s]+$/.test(email)) {
					showError(
						"Merci d'indiquer votre prénom et une adresse email valide.",
					);
					return;
				}
				if (!consent) {
					showError(
						"Merci d'accepter la politique de confidentialité et les CGV pour continuer.",
					);
					return;
				}
				const stripeUrl = STRIPE_LINKS[slug];
				if (!stripeUrl || !stripeUrl.startsWith("https://buy.stripe.com/")) {
					showError(
						"Petit souci de lien de paiement : merci de recharger la page ou de nous contacter.",
					);
					return;
				}

				submitBtn.disabled = true;
				submitBtn.textContent = "REDIRECTION EN COURS…";

				// Enregistrement du prospect (ne bloque jamais le paiement)
				let ref = "";
				try {
					const res = await fetch(LEAD_ENDPOINT, {
						method: "POST",
						headers: { "Content-Type": "application/json" },
						body: JSON.stringify({
							first_name: firstName,
							email: email,
							product_slug: slug,
							format_pref: formatPref,
						}),
					});
					if (res.ok) {
						const data = await res.json();
						if (data && data.ref) ref = data.ref;
					}
				} catch (_) {
					/* on redirige quand même vers le paiement */
				}

				const url = new URL(stripeUrl);
				url.searchParams.set("prefilled_email", email);
				if (ref) url.searchParams.set("client_reference_id", `${slug}__${ref}`);
				window.location.href = url.toString();
			});
		</script>
	</body>
</html>
