		<footer class="site-footer">
			<img src="/logo-alex.png" alt="Logo Alex" class="footer-logo" />
			© {new Date().getFullYear()} ATELIERS VENTE AVEC {
				expertName.toUpperCase()
			} - TOUS DROITS RÉSERVÉS
		</footer>

		<script is:inline>
			const form = document.getElementById("payment-form");
			form.addEventListener("submit", (e) => {
				e.preventDefault();
				const stripeUrl = document
					.getElementById("product-choice")
					.value.trim();
				const isValidStripeCheckout =
					stripeUrl.startsWith("https://buy.stripe.com") &&
					/^https:\/\/buy\.stripe\.com\/.+/.test(stripeUrl);

				if (!isValidStripeCheckout) {
					alert(
						"Petit souci de lien de paiement : merci de recharger la page ou de nous contacter pour finaliser votre inscription en toute sécurité.",
					);
					return;
				}
				// On peut ajouter ici une logique pour enregistrer l'email avant la redirection
				window.location.href = stripeUrl;
			});

			const countdownDays = document.getElementById("countdown-days");
			const countdownHours = document.getElementById("countdown-hours");
			const countdownMinutes =
				document.getElementById("countdown-minutes");
			const countdownSeconds =
				document.getElementById("countdown-seconds");
			const countdownTarget = new Date(
				"2026-04-23T09:00:00+02:00",
			).getTime();

			const pad = (value) => String(value).padStart(2, "0");

			const updateCountdown = () => {
				const now = Date.now();
				const timeLeft = countdownTarget - now;

				if (timeLeft <= 0) {
					countdownDays.textContent = "00";
					countdownHours.textContent = "00";
					countdownMinutes.textContent = "00";
					countdownSeconds.textContent = "00";
					return;
				}

				const totalSeconds = Math.floor(timeLeft / 1000);
				const days = Math.floor(totalSeconds / 86400);
				const hours = Math.floor((totalSeconds % 86400) / 3600);
				const minutes = Math.floor((totalSeconds % 3600) / 60);
				const seconds = totalSeconds % 60;

				countdownDays.textContent = pad(days);
				countdownHours.textContent = pad(hours);
				countdownMinutes.textContent = pad(minutes);
				countdownSeconds.textContent = pad(seconds);
			};

			updateCountdown();
			setInterval(updateCountdown, 1000);
		</script>
	</body>
</html>
