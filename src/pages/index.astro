---
// --- LIENS DE PAIEMENT STRIPE ---
const STRIPE_LINKS = {
	decouverte: "https://buy.stripe.com/8x214nf0k0XObfm4UB7EQ07",
	"seance-unique": "https://buy.stripe.com/28EcN52dyeOE1EMfzf7EQ06",
	"pack-3-seances": "https://buy.stripe.com/aFa9ATcSc0XO5V2evb7EQ05",
};

// Enregistrement des prospects dans Pilote 360 (Supabase)
const LEAD_ENDPOINT =
	"https://fjfutavsdlnernwtdsfu.supabase.co/functions/v1/formation-lead";

const title =
	"Coaching Vente Individuel pour Solopreneurs | La Méthode Alex";
const description =
	"Sessions de coaching commercial en tête-à-tête pour solopreneurs et indépendants : prospection, closing, objections. En visio, présentiel possible sur demande. Dès 80 €.";
const expertName = "Alex";

const modules = [
	{
		slug: "decouverte",
		num: "01",
		title: "SÉANCE DÉCOUVERTE",
		tool: "Diagnostic + 1 conseil actionnable",
		desc: "Une heure pour faire le point sur votre situation commerciale actuelle : ce qui bloque, ce qui fonctionne déjà, ce qui mérite d'être travaillé en priorité. Vous repartez avec un diagnostic clair et un conseil concret que vous pouvez appliquer immédiatement, que vous poursuiviez ou non avec un accompagnement.",
		price: "80€",
		duration: "1h",
	},
	{
		slug: "seance-unique",
		num: "02",
		title: "FORMATION VENTE — SÉANCE UNIQUE",
		tool: "Sur un blocage précis",
		desc: "Deux heures et demie concentrées sur un blocage identifié : closing, objections, phoning, structure de votre argumentaire... On part de votre réalité de terrain, pas d'un programme générique. Vous repartez avec une méthode applicable dès votre prochain rendez-vous client.",
		price: "200€",
		duration: "2h30",
	},
];
---

<html lang="fr">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta property="og:type" content="website" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:locale" content="fr_FR" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Oswald:wght@700&family=Montserrat:wght@400;700;900&display=swap"
			rel="stylesheet"
		/>
		<style>
			:root {
				--tony-black: #000000;
				--tony-orange: #ff5500;
				--tony-gray: #111111;
				--white: #ffffff;
				--nav-height: 84px;
			}

			body {
				background: var(--tony-black);
				color: var(--white);
				font-family: "Montserrat", sans-serif;
				margin: 0;
				scroll-behavior: smooth;
			}

			h1,
			h2,
			h3,
			.oswald {
				font-family: "Oswald", sans-serif;
				text-transform: uppercase;
			}

			.container {
				max-width: 1100px;
				margin: 0 auto;
				padding: 0 1.5rem;
			}

			.urgency-bar {
				background: #c44914;
				color: #000;
				font-weight: 900;
				text-align: center;
				padding: 0.85rem 1rem;
				letter-spacing: 0.4px;
				text-transform: uppercase;
			}

			.top-nav {
				position: sticky;
				top: 0;
				z-index: 1000;
				height: var(--nav-height);
				display: flex;
				align-items: center;
				background: rgba(0, 0, 0, 0.78);
				backdrop-filter: blur(8px);
				border-bottom: 2px solid #c44914;
			}

			.nav-inner {
				max-width: 1100px;
				width: 100%;
				margin: 0 auto;
				padding: 0 1.5rem;
				display: flex;
				align-items: center;
				justify-content: space-between;
			}

			.brand-logo {
				display: block;
				max-height: 60px;
				width: auto;
			}

			.nav-cta {
				color: var(--white);
				text-decoration: none;
				font-weight: 700;
				font-size: 0.9rem;
				letter-spacing: 1px;
				border: 2px solid var(--tony-orange);
				padding: 0.6rem 1.2rem;
				border-radius: 4px;
				transition: 0.3s;
			}
			.nav-cta:hover {
				background: var(--tony-orange);
			}

			/* HERO */
			.hero {
				min-height: 90vh;
				padding-top: calc(var(--nav-height) + 1.5rem);
				padding-bottom: 3rem;
				display: flex;
				flex-direction: column;
				justify-content: center;
				align-items: center;
				text-align: center;
				background:
					linear-gradient(rgba(0, 0, 0, 0.7), rgba(0, 0, 0, 0.7)),
					url("https://images.unsplash.com/photo-1552664730-d307ca884978?auto=format&fit=crop&w=1600&q=60");
				background-size: cover;
				background-position: center;
				border-bottom: 10px solid var(--tony-orange);
			}
			.hero h1 {
				font-size: 5.2rem;
				margin: 0;
				line-height: 0.95;
				letter-spacing: -2px;
				font-weight: 900;
			}
			.hero h1 span {
				color: var(--tony-orange);
			}
			.hero .subtitle {
				font-size: 1.5rem;
				color: #ccc;
				max-width: 850px;
				margin: 2rem auto;
				font-weight: 400;
			}
			.hero-badges {
				display: flex;
				flex-wrap: wrap;
				gap: 0.8rem;
				justify-content: center;
				margin-bottom: 2.2rem;
			}
			.hero-badge {
				border: 1px solid rgba(255, 255, 255, 0.35);
				background: rgba(0, 0, 0, 0.55);
				padding: 0.55rem 1.1rem;
				font-size: 0.85rem;
				font-weight: 700;
				letter-spacing: 1px;
				text-transform: uppercase;
			}
			.hero-badge strong {
				color: var(--tony-orange);
			}

			/* ÉTAPES */
			.steps {
				background: #0a0a0a;
				padding: 4.5rem 0;
				border-bottom: 1px solid #222;
			}
			.steps h2 {
				text-align: center;
				font-size: 2.6rem;
				margin-bottom: 3rem;
			}
			.steps-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 30px;
			}
			.step {
				border: 1px solid #333;
				background: #000;
				padding: 2.2rem;
				text-align: center;
			}
			.step-num {
				font-family: "Oswald", sans-serif;
				font-size: 2.6rem;
				color: var(--tony-orange);
				font-weight: 700;
			}
			.step h3 {
				font-size: 1.25rem;
				margin: 0.8rem 0;
			}
			.step p {
				color: #bbb;
				line-height: 1.7;
				margin: 0;
			}

			/* PAINS */
			.pains {
				background: var(--tony-gray);
				padding: 6rem 0;
				border-bottom: 1px solid #222;
			}
			.pains h2 {
				font-size: 3rem;
				text-align: center;
				margin-bottom: 1rem;
			}
			.pains .pains-sub {
				text-align: center;
				color: #bbb;
				font-size: 1.15rem;
				max-width: 750px;
				margin: 0 auto 4rem;
			}
			.pain-grid {
				display: grid;
				grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
				gap: 30px;
			}
			.pain-item {
				background: #000;
				border: 1px solid #333;
				padding: 2.5rem;
				border-radius: 4px;
				text-align: center;
				font-weight: 700;
				transition: 0.3s;
			}
			.pain-item:hover {
				border-color: var(--tony-orange);
				transform: translateY(-5px);
			}
			.pain-emoji {
				font-size: 3rem;
				margin-bottom: 1rem;
			}

			/* MODULES */
			.modules {
				padding: 7rem 0;
			}
			.module-row {
				background: #111;
				margin-bottom: 3rem;
				border: 1px solid #222;
				transition: 0.3s;
			}
			.module-row:hover {
				border-color: #444;
			}
			.module-content {
				padding: 4rem;
			}
			.module-content h3 {
				font-size: 2.5rem;
				margin: 1rem 0;
				color: #fff;
			}
			.tool-label {
				color: var(--tony-orange);
				font-weight: 900;
				letter-spacing: 2px;
				font-size: 0.9rem;
			}
			.module-desc {
				font-size: 1.2rem;
				line-height: 1.8;
				color: #bbb;
				margin-bottom: 2.5rem;
			}
			.module-footer {
				display: flex;
				justify-content: space-between;
				align-items: center;
				border-top: 1px solid #333;
				padding-top: 2rem;
				gap: 1rem;
				flex-wrap: wrap;
			}
			.module-price {
				font-size: 2.5rem;
				font-weight: 900;
			}
			.module-price small {
				display: block;
				font-size: 0.85rem;
				color: #888;
				font-weight: 400;
			}

			/* PACK */
			.pack-premium {
				background: linear-gradient(45deg, #000, #1a100a);
				border: 4px solid var(--tony-orange);
				padding: 5rem 3rem;
				text-align: center;
				margin-top: 6rem;
			}

			/* AUDIT & AUTOMATISATION — même traitement visuel que le pack, sans prix */
			.audit-cta {
				background: linear-gradient(45deg, #000, #1a100a);
				border: 4px solid var(--tony-orange);
				padding: 5rem 3rem;
				text-align: center;
				margin-top: 3rem;
			}

			/* FORMULAIRE & BOUTONS */
			.btn-tony {
				background: var(--tony-orange);
				color: white;
				padding: 1.5rem 3.5rem;
				text-decoration: none;
				font-weight: 900;
				display: inline-block;
				font-size: 1.3rem;
				border-radius: 4px;
				transition: 0.3s;
				border: none;
				cursor: pointer;
				font-family: "Oswald", sans-serif;
				text-transform: uppercase;
			}
			.btn-tony:hover {
				transform: scale(1.05);
				filter: brightness(1.2);
			}
			.btn-tony:disabled {
				opacity: 0.6;
				cursor: wait;
				transform: none;
			}

			.form-section {
				background: #fff;
				color: #000;
				padding: 5rem 0;
			}
			.form-card {
				max-width: 600px;
				margin: 0 auto;
			}
			.form-card h2 {
				font-size: 3rem;
				margin-bottom: 1rem;
				text-align: center;
			}
			.form-card label {
				display: block;
				font-weight: 700;
				margin-bottom: 0.4rem;
				font-size: 0.95rem;
			}
			input[type="text"],
			input[type="email"],
			select {
				width: 100%;
				padding: 1.2rem;
				margin-bottom: 1.5rem;
				border: 2px solid #eee;
				font-size: 1rem;
				font-family: "Montserrat", sans-serif;
				box-sizing: border-box;
				background: #fff;
			}
			.consent-row {
				display: flex;
				gap: 0.7rem;
				align-items: flex-start;
				margin-bottom: 1.5rem;
				font-size: 0.88rem;
				line-height: 1.55;
				color: #333;
			}
			.consent-row input {
				margin-top: 0.2rem;
				width: 1.1rem;
				height: 1.1rem;
			}
			.form-error {
				display: none;
				background: #ffe8e0;
				border-left: 4px solid #c0392b;
				color: #7b241c;
				padding: 0.9rem 1rem;
				margin-bottom: 1.4rem;
				font-size: 0.95rem;
			}

			.location-note {
				font-size: 1.02rem;
				line-height: 1.75;
				color: #1f1f1f;
				background: #fff4ed;
				border-left: 4px solid var(--tony-orange);
				padding: 1rem 1.1rem;
				margin: 0.3rem 0 1.4rem;
			}

			.site-footer {
				text-align: center;
				padding: 4rem 1.5rem;
				color: #666;
				border-top: 1px solid #111;
				font-size: 0.9rem;
				line-height: 2;
			}
			.footer-logo {
				display: block;
				width: 150px;
				max-width: 100%;
				height: auto;
				margin: 0 auto 1.2rem;
			}
			.footer-links a {
				color: #999;
				text-decoration: none;
				margin: 0 0.7rem;
			}
			.footer-links a:hover {
				color: var(--tony-orange);
			}

			.social-proof {
				font-size: 0.95rem;
				line-height: 1.5;
				font-weight: 700;
				max-width: 640px;
				margin: 1.3rem auto 0;
			}

			@media (max-width: 768px) {
				:root {
					--nav-height: 76px;
				}
				.urgency-bar {
					font-size: 0.78rem;
					line-height: 1.5;
				}
				.hero h1 {
					font-size: 3.2rem;
				}
				.module-content {
					padding: 2rem;
				}
				.pack-premium {
					padding: 3rem 1.5rem;
				}
				.audit-cta {
					padding: 3rem 1.5rem;
				}
			}

			/* CTA FLOTTANT VERS LE QUIZ /audit */
			.floating-audit-cta {
				position: fixed;
				z-index: 999;
				left: 1rem;
				right: 1rem;
				bottom: 1rem;
				text-align: center;
				background: var(--tony-orange);
				color: #fff;
				text-decoration: none;
				font-family: "Oswald", sans-serif;
				text-transform: uppercase;
				font-weight: 900;
				letter-spacing: 0.5px;
				font-size: 1rem;
				padding: 1rem 1.4rem;
				border-radius: 4px;
				box-shadow: 0 6px 24px rgba(0, 0, 0, 0.45);
				opacity: 0;
				transform: translateY(140%);
				pointer-events: none;
				transition:
					opacity 0.35s ease,
					transform 0.35s ease;
			}
			.floating-audit-cta.is-visible {
				opacity: 1;
				transform: translateY(0);
				pointer-events: auto;
			}
			.floating-audit-cta:hover {
				filter: brightness(1.15);
			}
			@media (min-width: 768px) {
				.floating-audit-cta {
					left: auto;
					right: 2rem;
					bottom: 2rem;
					font-size: 1.05rem;
					padding: 1.1rem 2rem;
				}
			}
			@media (prefers-reduced-motion: reduce) {
				.floating-audit-cta {
					transform: none;
					transition: none;
				}
				.floating-audit-cta.is-visible {
					transform: none;
				}
			}

			/* HERO — mise en page 2 colonnes : accroche à gauche, vidéo à droite */
			.hero-split {
				display: flex;
				gap: 3rem;
				align-items: center;
				justify-content: center;
				flex-wrap: wrap;
				width: 100%;
			}
			.hero-split-text {
				flex: 1 1 460px;
				min-width: 0;
				text-align: left;
			}
			.hero-split-text .hero-badges {
				justify-content: flex-start;
			}
			.hero-split-video {
				flex: 0 0 auto;
				line-height: 0;
			}
			.hero-split-video iframe {
				max-width: 100%;
				border-radius: 8px;
			}
			@media (max-width: 900px) {
				.hero-split-text {
					flex-basis: 100%;
					text-align: center;
				}
				.hero-split-text .hero-badges {
					justify-content: center;
				}
				.hero-split-video {
					flex-basis: 100%;
					display: flex;
					justify-content: center;
				}
			}
		</style>
	</head>
	<body>
		<div class="urgency-bar">
			QUELQUES CRÉNEAUX DISPONIBLES CHAQUE SEMAINE · SÉANCES EN VISIO
			(PRÉSENTIEL POSSIBLE SUR DEMANDE)
		</div>

		<nav class="top-nav">
			<div class="nav-inner">
				<img
					src="/logo-alex.png"
					alt="La Méthode Alex — coaching vente"
					class="brand-logo"
				/>
				<a href="#register" class="nav-cta">RÉSERVER MA SESSION</a>
			</div>
		</nav>

		<section class="hero">
			<div class="container">
				<div class="hero-split">
					<div class="hero-split-text">
						<h1>
							VOUS ÊTES SEUL À VENDRE.<br />
							<span>PAS SEUL POUR APPRENDRE.</span>
						</h1>
						<p class="subtitle">
							Coaching commercial en tête-à-tête pour solopreneurs
							et indépendants. Ma mission : vous transmettre des
							outils concrets qui deviennent des leviers immédiats
							de croissance. Vous repartez de chaque session avec un
							plan d'action prêt à l'emploi, pour vendre dès le
							lendemain et transformer chaque opportunité en client
							fidèle.
						</p>
						<div class="hero-badges">
							<div class="hero-badge">
								<strong>1:1</strong> — Session individuelle sur-mesure
							</div>
							<div class="hero-badge">
								<strong>En visio</strong> par défaut — présentiel sur
								demande
							</div>
							<div class="hero-badge">
								<strong>À la carte</strong> — découverte, séance
								unique ou pack de suivi
							</div>
						</div>
						<a href="#register" class="btn-tony">RÉSERVER MA SESSION</a>
					</div>
					<div class="hero-split-video">
						<iframe
							src="https://app.heygen.com/embeds/e6545eead0ac4fb5ab50920c8ebd2d19"
							width="360"
							height="640"
							frameborder="0"
							allow="autoplay; fullscreen"
							title="Présentation vidéo — La Méthode Alex"
						></iframe>
					</div>
				</div>
			</div>
		</section>

		<section class="steps">
			<div class="container">
				<h2>COMMENT ÇA MARCHE ?</h2>
				<div class="steps-grid">
					<div class="step">
						<div class="step-num">1</div>
						<h3>Choisissez votre format</h3>
						<p>
							Une séance découverte pour démarrer, une séance
							unique sur un blocage précis, ou le pack de 3
							séances pour un suivi dans la durée.
						</p>
					</div>
					<div class="step">
						<div class="step-num">2</div>
						<h3>Réglez en ligne</h3>
						<p>
							Paiement sécurisé par Stripe. Vous recevez
							immédiatement votre confirmation par email.
						</p>
					</div>
					<div class="step">
						<div class="step-num">3</div>
						<h3>Je vous contacte sous 24h</h3>
						<p>
							Nous fixons ensemble la date de votre session, en
							visio (présentiel possible sur demande), selon vos
							disponibilités.
						</p>
					</div>
				</div>
			</div>
		</section>

		<section class="pains">
			<div class="container">
				<h2>POURQUOI VOUS NE SIGNEZ PAS ASSEZ ?</h2>
				<p class="pains-sub">
					Quand on est solopreneur, personne ne vend à votre place.
					Chaque blocage commercial se paie directement sur votre
					chiffre d'affaires.
				</p>
				<div class="pain-grid">
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">🤐</div>
						L'OBJECTION VOUS FAIT RECULER
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">📞</div>
						LE PHONING VOUS PARALYSE
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">📉</div>
						VOTRE CLOSING EST ALÉATOIRE
					</div>
					<div class="pain-item">
						<div class="pain-emoji" aria-hidden="true">🧱</div>
						VOTRE PRIX EST UN OBSTACLE
					</div>
				</div>
			</div>
		</section>

		<section class="modules">
			<div class="container">
				<h2
					style="text-align:center; font-size: 4rem; margin-bottom: 1.5rem;"
				>
					CHOISISSEZ VOTRE FORMAT
				</h2>
				<p
					style="text-align:center; color:#bbb; font-size:1.15rem; max-width:750px; margin:0 auto 5rem;"
				>
					Chaque séance est individuelle, adaptée à VOTRE activité
					et VOS blocages du moment. Commencez par un diagnostic,
					réglez un point précis, ou prenez un suivi sur plusieurs
					séances.
				</p>

				{
					modules.map((m) => (
						<div class="module-row" id={m.slug}>
							<div class="module-content">
								<span class="tool-label">
									{m.tool}
								</span>
								<h3>
									{m.num}. {m.title}
								</h3>
								<p class="module-desc">{m.desc}</p>
								<div class="module-footer">
									<span class="module-price">
										{m.price}
										<small>{m.duration} · session individuelle</small>
									</span>
									<a
										href="#register"
										class="btn-tony js-choose-module"
										data-slug={m.slug}
										style="padding: 1rem 2rem; font-size: 1rem;"
									>
										RÉSERVER CETTE SÉANCE
									</a>
								</div>
							</div>
						</div>
					))
				}

				<div class="pack-premium">
